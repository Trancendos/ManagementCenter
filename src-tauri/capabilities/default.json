{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Management Center main window. HTTP is limited to the platform services on this machine plus the Infinity issuer.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:*" },
        { "url": "http://localhost:*" },
        { "url": "https://auth.trancendos.com/*" }
      ]
    }
  ]
}
