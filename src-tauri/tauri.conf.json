{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trancendos Management Center",
  "version": "0.1.0",
  "identifier": "com.trancendos.managementcenter",
  "build": {
    "beforeDevCommand": "npm run desktop:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run desktop:build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Trancendos Management Center",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "category": "Business",
    "shortDescription": "Admin console for TownHall and the Service Management Center",
    "windows": {
      "wix": { "language": "en-GB" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
